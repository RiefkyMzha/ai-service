# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env (sudah di-ignore).

# Wajib: API key OpenRouter untuk analisis AI.
OPENROUTER_API_KEY=

# Opsional: ID model multimodal di OpenRouter (default gratis: nvidia/nemotron-3.5-super-vl:free).
# Opsi produksi Paid ZDR terkalibrasi: z-ai/glm-5.3-flash (dengan OpenRouter Default Provider Sort = Throughput).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Opsional: Base URL endpoint chat completions (default https://openrouter.ai/api/v1/chat/completions).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Opsional: true hanya bila OPENROUTER_MODEL punya endpoint Zero Data Retention (default false).
OPENROUTER_ZDR_ONLY=false

# Opsional: true untuk mengunci skema output JSON dengan json_schema strict (default false = json_object).
OPENROUTER_STRUCTURED_OUTPUTS=false

# Opsional: pilih SALAH SATU budget reasoning (jangan keduanya).
# Untuk z-ai/glm-5.3-flash Paid ZDR: gunakan OPENROUTER_REASONING_EFFORT=medium (kosongkan REASONING_MAX_TOKENS).
# Untuk nvidia/nemotron-3.5-super-vl: kosongkan EFFORT dan gunakan REASONING_MAX_TOKENS (bila paid ZDR, pakai MAX_TOKENS=8000).
# none/minimal/low/medium/high/xhigh/max. Kosong = default provider.
OPENROUTER_REASONING_EFFORT=
# Batas token reasoning (angka pasti; untuk Nemotron :free: 2048 atau 1536). Kosong = default provider.
OPENROUTER_REASONING_MAX_TOKENS=

# Opsional: total token output (reasoning + JSON; rekomendasi Paid ZDR GLM/Nemotron: 8000; Nemotron :free: 3584/3072).
# Min 1536, atau >= REASONING_MAX_TOKENS + 1200.
OPENROUTER_MAX_TOKENS=

# Wajib: token rahasia antar-service. Backend utama aplikasi web mengirimnya lewat header X-API-Token.
# Kosong = semua endpoint /api/v1 ditolak (500). Buat nilai acak panjang, mis.:
#   python -c "import secrets; print(secrets.token_hex(32))"
CEGAHSCAM_API_TOKEN=

# Opsional: DEBUG/INFO/WARNING/ERROR (default INFO).
LOG_LEVEL=INFO

# Opsional: Set true untuk uji integrasi lokal/online tanpa memanggil OpenRouter & GetContact (default false).
MOCK_MODE=false

# Opsional: Daftar origin CORS dipisahkan koma untuk akses dari frontend browser (default *).
CORS_ORIGINS=*
