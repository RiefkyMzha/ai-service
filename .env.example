# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env (sudah di-ignore).

# Wajib: API key OpenRouter untuk analisis AI.
OPENROUTER_API_KEY=

# Opsional: ID model multimodal di OpenRouter (default nvidia/nemotron-3.5-super-vl:free).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Opsional: Base URL endpoint chat completions (default https://openrouter.ai/api/v1/chat/completions).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Wajib: token rahasia antar-service. Backend utama aplikasi web mengirimnya lewat header X-API-Token.
# Kosong = semua endpoint /api/v1 ditolak (500). Buat nilai acak panjang, mis.:
#   python -c "import secrets; print(secrets.token_hex(32))"
CEGAHSCAM_API_TOKEN=

# Opsional: DEBUG/INFO/WARNING/ERROR (default INFO).
LOG_LEVEL=INFO

# Opsional: Set true untuk uji integrasi lokal/online tanpa memanggil OpenRouter & GetContact (default false).
MOCK_MODE=false

# Opsional: Daftar origin CORS dipisahkan koma untuk akses dari frontend browser (default *).
CORS_ORIGINS=*
